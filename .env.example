# Use the local Backend by default. Set this to an empty string for mock mode.
VITE_API_BASE_URL="http://localhost:4000/api"

# Endpoint paths are relative to VITE_API_BASE_URL.
VITE_AUTH_ENDPOINT="/auth/login"
VITE_COUNSELORS_ENDPOINT="/admin/counselors"
VITE_COUNSELOR_DETAIL_ENDPOINT="/admin/counselors/:id"
VITE_DASHBOARD_ENDPOINT="/admin/dashboard"
VITE_ANALYTICS_FILTERS_ENDPOINT="/admin/analytics/filters"
VITE_STUDENT_TRENDS_ENDPOINT="/admin/analytics/student-trends"
VITE_FEEDBACK_ANALYTICS_ENDPOINT="/admin/analytics/feedback"
VITE_ANALYTICS_EXPORT_ENDPOINT="/admin/analytics/export"
VITE_AUDIT_LOGS_ENDPOINT="/admin/audit-logs"
VITE_STUDENTS_ENDPOINT="/students"
VITE_API_TIMEOUT_MS="10000"
VITE_CRUD_DEMO_MODE="false"
# Bản bàn giao hiện tại luôn khóa CRUD trên web; hai URL dưới đây mở Google Sheet quản lý dữ liệu.
VITE_GOOGLE_STUDENT_ENTRY_URL=""
VITE_GOOGLE_STUDENT_THCS_ENTRY_URL=""
VITE_GOOGLE_STUDENT_THPT_ENTRY_URL=""
VITE_GOOGLE_COUNSELOR_ENTRY_URL=""
VITE_STUDENT_SYNC_INTERVAL_MS="10000"
