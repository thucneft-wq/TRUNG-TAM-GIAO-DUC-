# Copy this file to .env.docker before running Docker Compose.
# Never commit .env.docker.

WEB_PORT=8080
PUBLIC_APP_ORIGIN=http://localhost:8080

POSTGRES_DB=psycholo_final
POSTGRES_USER=psycholo_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# URL-encode special characters in the password used below.
DATABASE_URL='postgresql://psycholo_app:replace-with-a-strong-database-password@database:5432/psycholo_final'

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@campus-counseling.edu
ADMIN_PASSWORD_HASH='replace-with-a-bcrypt-hash'
GOOGLE_SHEETS_SYNC_SECRET=replace-with-a-random-secret-at-least-32-characters
MIN_ANALYTICS_SAMPLE_SIZE=5

GOOGLE_STUDENT_ENTRY_URL=
GOOGLE_STUDENT_THCS_SHEET_URL=https://docs.google.com/spreadsheets/d/1VFfQsEoNPE_WCP1SHYMFsN2n-Y4V4_RVvt77Iv305Bg/edit?gid=1158513315#gid=1158513315&range=O:P
GOOGLE_STUDENT_THPT_SHEET_URL=https://docs.google.com/spreadsheets/d/1VFfQsEoNPE_WCP1SHYMFsN2n-Y4V4_RVvt77Iv305Bg/edit?gid=1783407659#gid=1783407659&range=O:P
GOOGLE_COUNSELOR_ENTRY_URL=https://docs.google.com/spreadsheets/d/1VFfQsEoNPE_WCP1SHYMFsN2n-Y4V4_RVvt77Iv305Bg/edit?gid=1832606455#gid=1832606455
STUDENT_SYNC_INTERVAL_MS=10000
